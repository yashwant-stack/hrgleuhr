PORT=3000
# Public portal address used in email links. On Vercel set this to the final domain
# (if unset there, the project's production domain is used automatically).
APP_URL=http://localhost:3000
TRAINING_TIMEZONE=Asia/Kolkata

# Hosted only: DIRECT (non-pooled) PostgreSQL URL. The app uses session advisory locks,
# so a pooled/PgBouncer URL will not work. Leave empty locally (local JSON storage is used).
DATABASE_URL_UNPOOLED=

# Hosted only: long random secret. Callers of /api/cron/mail must send
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Sender requested by Rahul. Copy this file to .env and enter the account's
# SMTP app password locally. Never put the password in chat or source control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=mizraem@gleuhr.com
SMTP_USER=mizraem@gleuhr.com
SMTP_PASS=

# Optional AI patient role-play. Guided role-play works without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
